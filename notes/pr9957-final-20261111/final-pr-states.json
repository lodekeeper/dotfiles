    "title": "fix: initialize the proposer lookahead of fulu genesis states",
    "user": {
      "login": "lodekeeper",
      "id": 258435968,
      "node_id": "U_kgDOD2drgA",
      "avatar_url": "https://avatars.githubusercontent.com/u/258435968?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/lodekeeper",
      "html_url": "https://github.com/lodekeeper",
      "followers_url": "https://api.github.com/users/lodekeeper/followers",
      "following_url": "https://api.github.com/users/lodekeeper/following{/other_user}",
